// Copy to Config/Secrets.xcconfig (git-ignored) and fill in. Debug builds only: the values ship inside the app binary.
ANTHROPIC_AUTH_TOKEN = your-token-here
// xcconfig treats "//" as a comment, so write the URL's slashes as "/$()/":
ANTHROPIC_BASE_URL = https:/$()/your-gateway.example.com
// Leave ANTHROPIC_BASE_URL out to use https://api.anthropic.com
